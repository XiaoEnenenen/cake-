  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  line-height: 80rpx;
  color: #1f1f1f;
}
/* 2026-10-10：核销二维码区块删除，.hx-canvas 样式一并移除 */
/* ===== 门店地图板块外层（components/shop-map）=====
   2026-10-09 新增：替代原来的内联样式 map 容器，统一左右边距。 */
.shopmap-block {
  width: 100%;
  padding: 0 30rpx 20rpx;
  box-sizing: border-box;
}

