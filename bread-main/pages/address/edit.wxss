@import "./common.wxss";

/* 编辑页专属样式（通用部分见 common.wxss） */
.edit-note {
  margin: 20rpx 40rpx 0;
  font-size: 22rpx;
  color: #b3b3b3;
  line-height: 32rpx;
}

/* 2026-10-09 新增：底部固定「保存」按钮的占位高度。
   原表单最后一行的「标签」卡片正好落在固定按钮下面（截图反馈被遮挡），
   删除标签后由本占位保证「设为默认地址」行完整可见。
   高度 = 按钮 88rpx + 上下内边距 40rpx + 安全区，取 180rpx。 */
.edit-bottom-holder {
  height: 180rpx;
}
