/* ===== 「我的」页面样式 =====
   改造说明：原样式围绕「会员卡 + 积分」设计（含绝对定位的白卡、82rpx 左缩进等），
   现按新版结构重写为分区卡片式布局。配色沿用全站白黄令牌（见 app.wxss）。
   2026-10-12 阶段 5.7：删除本文件里与 app.wxss 完全重复的 `page { background-color: #f5f5f5; }`
   （app.wxss 是全局样式，页面再写一遍同样声明不会改变任何计算值，只是重复）。
*/

/* ===== 顶部黄色装饰带 ===== */
.mycard {
  height: 160rpx;
  width: 100vw;
  background-color: #ffd100;
}

/* ===== 1. 用户信息卡 ===== */
.card-bar {
  position: relative;
  margin: -110rpx 30rpx 0;
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx 0 rgba(0, 0, 0, 0.06);
}

.user-row {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.user-avatar-empty {
  border: 2rpx dashed #d0d0d0;
}

.user-meta {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.user-nick {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f1f1f;
  line-height: 48rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-id {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 阶段 5.5：资料编辑（chooseAvatar + nickname）===== */

/* 右侧「编辑 / 去填写」入口 */
.user-edit {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #8a6d00;
  background-color: #fff7d6;
  border-radius: 28rpx;
}

/* 头像选择按钮：去掉 button 默认样式（边框/背景/内边距），
   否则 110rpx 的圆头像外面会多出一圈灰框 */
.user-avatar-btn {
  padding: 0;
  margin: 0;
  width: 110rpx;
  height: 110rpx;
  line-height: 1;
  background-color: transparent;
  border: none;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: visible;
}
.user-avatar-btn::after {
  border: none;
}

/* 昵称输入框 */
.user-nick-input {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f1f1f;
  height: 56rpx;
  line-height: 56rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

/* 头像未上传成功时的提示（此时不允许保存，见 pages/my/index.js 的 saveProfile） */
.user-avatar-warn {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ff4b33;
}

.user-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 24rpx;
}

.user-btn {
  min-width: 140rpx;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.user-btn-ghost {
  color: #666666;
  background-color: #f5f5f5;
  margin-right: 16rpx;
}

.user-btn-primary {
  color: #1f1f1f;
  background-color: #ffd100;
}

.user-btn-disabled {
  opacity: 0.6;
}

/* ===== 通用分区 ===== */
.section {
  margin: 24rpx 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.section-head {
  padding: 26rpx 30rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f1f1f;
}

/* ===== 2. 订单入口 ===== */
.order-entries {
  display: flex;
  align-items: center;
  padding: 24rpx 0 30rpx;
}

.order-entry {
  flex: 1;
  text-align: center;
}

.order-entry-label {
  font-size: 26rpx;
  color: #3c3c3c;
}

/* ===== 3. 列表项 ===== */
.list-item {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 28rpx 30rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f2f3f5;
  background-color: #ffffff;
  text-align: left;
  line-height: normal;
}

.list-item:last-child {
  border-bottom: none;
}

/* button 作为列表项时需要清除默认样式 */
.list-item-btn {
  border-radius: 0;
  font-weight: normal;
}

.list-item-btn::after {
  border: none;
}

.list-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.list-body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.list-title {
  font-size: 30rpx;
  color: #1f1f1f;
}

.list-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8a8a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-sub-empty {
  color: #b3b3b3;
}

.list-arrow {
  width: 20rpx;
  height: 20rpx;
  border: solid #c0c0c0;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(-45deg);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ===== 4. 门店信息 ===== */
.store-block {
  padding: 24rpx 30rpx 30rpx;
}

.store-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f1f1f;
  margin-bottom: 16rpx;
}

.store-row {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
}

.store-label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #8a8a8a;
}

.store-value {
  flex: 1;
  font-size: 26rpx;
  color: #3c3c3c;
  line-height: 38rpx;
}

/* 2026-10-09：原「一键导航到店」按钮（.store-nav-btn / .disabled）已由
   components/shop-map 组件内的 .shopmap-nav-btn 取代，此处样式删除。 */

/* 店主专用的「校准门店坐标」入口（仅开发版/体验版渲染） */
.store-locator-entry {
  margin-top: 24rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #8a8a8a;
  text-decoration: underline;
}

/* ===== 底部留白（给自定义 tabbar 让位）===== */
.bottom {
  height: 180rpx;
}
