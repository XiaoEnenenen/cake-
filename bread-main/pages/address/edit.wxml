<!-- ===== 新增 / 编辑收货地址 =====
     说明：本页只管「顾客自己的收货地址」，与门店地址无关。
     地图选点为可选能力：未声明 chooseLocation 权限时可手动填写，不影响保存。
 -->
<view class="form-card">
  <view class="form-row">
    <view class="form-label">收货人</view>
    <input
      class="form-input"
      placeholder="请填写收货人姓名"
      placeholder-class="form-placeholder"
      value="{{ name }}"
      data-field="name"
      bindinput="onInput"
      maxlength="20"
    />
  </view>

  <view class="form-row">
    <view class="form-label">手机号</view>
    <input
      class="form-input"
      type="number"
      placeholder="请填写收货人手机号"
      placeholder-class="form-placeholder"
      value="{{ phone }}"
      data-field="phone"
      bindinput="onInput"
      maxlength="11"
    />
  </view>

  <!-- 2026-10-14 删除：「所在地区（省/市/区）」整行（店主真机反馈）。
       删除的三个理由：
         1) 它对本店**没有任何作用**：配送范围是按详细地址里的文字（含「太平新城」）判断的，
            而行政区划选择器最细只到**区县**（安宁市），**永远给不出「太平新城」**这三个字
            ——填了也帮不上判定；
         2) 地图选点（下面的 wx.chooseLocation）返回的 `res.address` **本身就是完整地址**
            （已含省市街道），再拼一次省市区就会出现
            “云南省昆明市安宁市云南省昆明市安宁市太平新城街道…”这种重复文字（店主截图里就是）；
         3) 排版也乱：标签 + 占位文案两行挤在一起。
       ⚠️ 数据兼容：`province/city/district` 三个字段**保留在数据里**（老地址仍有值，
       保存时新地址写空串），只是不再提供输入入口；`utils/address.js` 的 formatFull
       对"详细地址已含省市区"的情况做了去重（见该函数注释）。 -->

  <!-- 地图选点：微信原生 wx.chooseLocation，无需第三方地图插件与 key -->
  <view class="form-row" bindtap="onChooseLocation">
    <view class="form-label">地图选点</view>
    <view class="form-picker {{ latitude ? '' : 'form-placeholder' }}">
      {{ latitude ? '已选点，可点击重新选择' : '可选：打开地图精确选点' }}
    </view>
    <view class="form-arrow"></view>
  </view>

  <view class="form-row">
    <view class="form-label">详细地址</view>
    <input
      class="form-input"
      placeholder="街道、小区、门牌号等"
      placeholder-class="form-placeholder"
      value="{{ detail }}"
      data-field="detail"
      bindinput="onInput"
      maxlength="60"
    />
  </view>
</view>

<!-- 2026-10-12 阶段 5.7：提示文案与 onSave 的实际校验对齐。
     原文案写「省市区与详细地址至少填其一即可下单」，但 onSave 里**详细地址是必填**
     （edit.js 的 `if (!detail)` 会拦下），照着提示做会被打回，属于自相矛盾的引导。
     现在如实写成：姓名 / 手机号 / 详细地址必填，省市区选填。 -->
<view class="edit-note">
  提示：收货人、手机号、详细地址为必填。建议用上面的「地图选点」（选点后会自动带出完整地址），
  或手写清小区与门牌；配送范围按详细地址里的文字判断（含「太平新城」即送）。
</view>

<!-- 2026-10-14 删除：空的 van-area 弹层（Vant 的 area 组件必须由使用方提供
     area-list，项目没装 @vant/area-data → 三列全空，真机复现为"一大片空白"）。
     随后「所在地区」整行也一并删除，原因见文件上方注释。本页不再需要任何自定义组件。 -->

<!-- 2026-10-09 删除：「标签（家 / 公司 / 学校 / 其他）」整块。
     删除原因：该卡片位于表单最底部，被固定定位的「保存」按钮压住且无法滚动到；
     店主确认不需要地址标签，故整体移除（含 edit.js 的 tags/tag/onTagTap 与相关样式）。 -->

<view class="default-row">
  <view>设为默认地址</view>
  <switch checked="{{ isDefault }}" color="#ffd100" bindchange="onDefaultChange" />
</view>

<!-- 底部占位：避免「设为默认地址」被固定定位的保存按钮遮挡 -->
<view class="edit-bottom-holder"></view>

<view class="addr-bottom">
  <view class="addr-btn {{ saving ? 'disabled' : '' }}" bindtap="onSave">
    {{ saving ? '保存中…' : '保存' }}
  </view>
</view>

<!-- 阶段 12：首次启动隐私授权弹窗（全局组件；已同意过则不会出现） -->
<privacy-popup />
