<!-- ===== 「我的」页面 =====
     改造说明见 pages/my/index.js 顶部注释。
     2026-09-26 阶段二：会员卡 / 积分 / 积分记录 / 编辑会员卡信息 已**整体删除**
     （页面文件、app.json 路由、云函数 action、数据库集合引用均已移除）。
     2026-10-10：扫码核销也整体下线（本页入口与 scan-result 页一起删除），
     店主改为在订单列表里对取餐码点「完成订单」。因此本页只保留：
     用户信息、订单入口、收货地址、客服、门店信息、导航、拨号。

     注意：门店信息全部来自 shop-config.js（用户提供的真实值），页面不写死任何门店数据。
-->

<!-- ===== 1. 用户信息区 =====
     2026-10-12 阶段 5.5（缺陷 P-06）重做：
       原实现用 wx.getUserProfile 拿头像昵称，但该接口自 2022 年起只返回匿名数据
       （灰色头像 + "微信用户"），于是本页永远停在"点击登录"。
       现改用微信官方的「头像昵称填写能力」：
         · 头像 → <button open-type="chooseAvatar" bind:chooseavatar>
         · 昵称 → <input type="nickname">
       选中的头像会先上传到云存储（utils/api-map 的 uploadFile），保存时只写 fileID。
     同时按报告 P-12：这里显示的是 openid 派生的**短编号**（userNo），不再直接展示 OPENID。
-->
<view class="mycard"></view>
<view class="card-bar">

  <!-- 展示态：已有头像或昵称即可（2026-10-12 复核整改：
       原来只判断 avatarUrl，顾客"只填昵称、不选头像"保存成功后，卡片又变回
       「点击完善资料」，看不到刚填的昵称，会以为没保存而反复提交。） -->
  <block wx:if="{{ userInfo && (userInfo.avatarUrl || userInfo.nick) && !profileEditing }}">
    <view class="user-row">
      <image
        wx:if="{{ userInfo.avatarUrl }}"
        class="user-avatar"
        mode="aspectFill"
        src="{{ userInfo.avatarUrl }}"
      ></image>
      <view wx:else class="user-avatar user-avatar-empty"></view>
      <view class="user-meta">
        <view class="user-nick">{{ userInfo.nick || '微信用户' }}</view>
        <view class="user-id">用户编号：{{ userNo }}</view>
      </view>
      <view class="user-edit" bindtap="startEditProfile">编辑</view>
    </view>
  </block>

  <!-- 未完善资料：引导填写（不再调用 getUserProfile） -->
  <block wx:elif="{{ !profileEditing }}">
    <view class="user-row">
      <view class="user-avatar user-avatar-empty"></view>
      <view class="user-meta">
        <!-- 2026-10-14 审查修复：把"云函数不通/资料没拉到"与"还没登录"区分开，
             否则顾客看到「点击完善资料」点进去也保存不了，且没有任何提示 -->
        <block wx:if="{{ profileError }}">
          <view class="user-nick">资料加载失败</view>
          <view class="user-id">请检查网络后重试</view>
        </block>
        <block wx:else>
          <view class="user-nick">点击完善资料</view>
          <view class="user-id">填写头像与昵称，方便我们称呼您</view>
        </block>
      </view>
      <view wx:if="{{ profileError }}" class="user-edit" bindtap="retryProfile">点击重试</view>
      <view wx:else class="user-edit" bindtap="startEditProfile">去填写</view>
    </view>
  </block>

  <!-- 编辑态：选头像 + 填昵称 + 保存 -->
  <block wx:else>
    <view class="user-row">
      <button
        class="user-avatar-btn"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseAvatar"
      >
        <image
          wx:if="{{ draftAvatarUrl }}"
          class="user-avatar"
          mode="aspectFill"
          src="{{ draftAvatarUrl }}"
        ></image>
        <view wx:else class="user-avatar user-avatar-empty"></view>
      </button>
      <view class="user-meta">
        <input
          class="user-nick-input"
          type="nickname"
          maxlength="20"
          value="{{ draftNick }}"
          placeholder="请输入昵称"
          bindinput="onNickInput"
          bindblur="onNickInput"
        />
        <view wx:if="{{ draftAvatarIsLocal }}" class="user-avatar-warn">头像还没上传成功</view>
        <view wx:else class="user-id">点击左侧头像可选择微信头像</view>
      </view>
    </view>
    <view class="user-actions">
      <view class="user-btn user-btn-ghost" bindtap="cancelEditProfile">取消</view>
      <view
        class="user-btn user-btn-primary {{ savingProfile ? 'user-btn-disabled' : '' }}"
        bindtap="saveProfile"
      >{{ savingProfile ? '保存中…' : '保存' }}</view>
    </view>
  </block>
</view>

<!-- ===== 2. 订单管理区（高频入口）===== -->
<view class="section">
  <view class="section-head">
    <view class="section-title">我的订单</view>
  </view>
  <view class="order-entries">
    <view
      wx:for="{{ orderEntries }}"
      wx:key="key"
      class="order-entry"
      data-status="{{ item.key }}"
      bindtap="goOrders"
    >
      <view class="order-entry-label">{{ item.label }}</view>
    </view>
  </view>
</view>

<!-- ===== 3. 常用功能 ===== -->
<view class="section">
  <view class="list-item" bindtap="goAddress">
    <image class="list-icon" mode="aspectFit" src="/images/user-icon-edit@2x.png"></image>
    <view class="list-body">
      <view class="list-title">收货地址</view>
      <view wx:if="{{ defaultAddressText }}" class="list-sub">{{ defaultAddressText }}</view>
      <view wx:else class="list-sub list-sub-empty">还没有收货地址，点击添加</view>
    </view>
    <view class="list-arrow"></view>
  </view>

  <!-- 联系客服：微信原生客服能力（open-type="contact"），无需云开发 -->
  <!-- 注意：需先在小程序后台「功能 → 客服」添加客服人员，否则点击无响应 -->
  <button class="list-item list-item-btn" open-type="contact" hover-class="none">
    <image class="list-icon" mode="aspectFit" src="/images/user-icon-contact@2x.png"></image>
    <view class="list-body">
      <view class="list-title">联系客服</view>
      <view class="list-sub">在线咨询，营业时间 {{ shop.openingHours }}</view>
    </view>
    <view class="list-arrow"></view>
  </button>

  <view class="list-item" bindtap="callShop">
    <image class="list-icon" mode="aspectFit" src="/images/user-icon-login@2x.png"></image>
    <view class="list-body">
      <view class="list-title">拨打门店电话</view>
      <view class="list-sub">{{ shop.phone || '暂未设置电话' }}</view>
    </view>
    <view class="list-arrow"></view>
  </view>
</view>

<!-- ===== 4. 门店信息 ===== -->
<view class="section">
  <view class="section-head">
    <view class="section-title">门店信息</view>
  </view>

  <view class="store-block">
    <view class="store-name">{{ shop.name }}</view>

    <view class="store-row">
      <view class="store-label">地址</view>
      <view class="store-value">{{ shop.address || '暂未设置' }}</view>
    </view>

    <view class="store-row">
      <view class="store-label">营业时间</view>
      <view class="store-value">{{ shop.openingHours || '暂未设置' }}</view>
    </view>

    <view class="store-row">
      <view class="store-label">电话</view>
      <view class="store-value">{{ shop.phone || '暂未设置' }}</view>
    </view>

    <!-- 门店地图板块（components/shop-map）：
         地图 + 门店标记 + 用户定位（授权后显示蓝点与「距离您 X」）+ 一键导航到店。
         定位授权、失败降级提示、坐标缺失占位都在组件内处理。 -->
    <shop-map
      shop="{{ shop }}"
      height="300rpx"
      show-address="{{ false }}"
      show-navigate="{{ true }}"
    />

    <!-- 店主专用：校准门店坐标（只在开发版 / 体验版显示，正式版顾客看不到） -->
    <view wx:if="{{ isDevEnv }}" class="store-locator-entry" bindtap="goShopLocator">
      校准门店坐标（店主专用，正式版不显示）
    </view>
  </view>
</view>

<!-- ===== 5. 关于我们 ===== -->
<view class="section">
  <view class="list-item" bindtap="goAbout">
    <image class="list-icon" mode="aspectFit" src="/images/user-icon-about@2x.png"></image>
    <view class="list-body">
      <view class="list-title">关于{{ shop.name }}</view>
    </view>
    <view class="list-arrow"></view>
  </view>
</view>

<view class="bottom"></view>
<!-- 底部导航栏 -->
<import src="/template/tabbar/index.wxml" />
<template is="tabbar" data="{{ tabbarActive: 3 }}" />
