@import "./common.wxss";

/* 编辑页专属样式（通用部分见 common.wxss） */
.edit-note {
  margin: 20rpx 40rpx 0;
  font-size: 22rpx;
  color: #b3b3b3;
  line-height: 32rpx;
}

/* 底部固定「保存」按钮的占位高度。
   高度 = 按钮 88rpx + 上下内边距 40rpx + iPhone 安全区（约 68rpx）。
   2026-10-17 修正：原来写死 180rpx，在有安全区的机型上最后一行仍会被按钮压住；
   改成 calc(160rpx + env(safe-area-inset-bottom))，与底部栏的实际高度对得上。 */
.edit-bottom-holder {
  height: calc(160rpx + env(safe-area-inset-bottom));
}
