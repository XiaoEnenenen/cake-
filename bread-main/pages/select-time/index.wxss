/* ===== 期望时间选择页样式（白黄主题）===== */

page {
  background-color: #f5f5f5;
}

.st-wrap {
  padding: 30rpx;
}

.st-tip {
  font-size: 26rpx;
  color: #ff2d2d;
  line-height: 38rpx;
  margin-bottom: 20rpx;
}

.st-tip-sub {
  color: #8a8a8a;
}

.st-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 0 30rpx;
}

.st-row {
  display: flex;
  align-items: center;
  min-height: 110rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.st-row:last-child {
  border-bottom: none;
}

.st-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  color: #1f1f1f;
}

.st-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.st-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f1f1f;
}

.st-value-empty {
  font-size: 28rpx;
  font-weight: normal;
  color: #b3b3b3;
}

.st-arrow {
  width: 20rpx;
  height: 20rpx;
  border: solid #c0c0c0;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(-45deg);
}

.st-note {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #8a8a8a;
  line-height: 36rpx;
}

.st-bottom {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 750rpx;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  background-color: #ffffff;
  box-shadow: 0 -2rpx 12rpx 0 rgba(0, 0, 0, 0.05);
}

.st-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.st-btn-cancel {
  background-color: #f5f5f5;
  color: #3c3c3c;
  margin-right: 24rpx;
}

.st-btn-ok {
  background-color: #ffd100;
  color: #1f1f1f;
}

.st-btn-ok.disabled {
  background-color: #ebebeb;
  color: #b3b3b3;
}
