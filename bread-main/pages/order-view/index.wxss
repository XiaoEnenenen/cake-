/* 阶段 5.6（缺陷 P-07）：加载失败时的整页提示 + 重试入口。
   此前接口失败时页面只剩空标题行，顾客看到的是"白屏"且无从下手。 */
.order-error{
  padding: 220rpx 60rpx 0;
  text-align: center;
}
.order-error-title{
  font-size: 32rpx;
  font-weight: 600;
  color: #1f1f1f;
}
.order-error-tip{
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8a8a8a;
  line-height: 36rpx;
}
.order-error-retry{
  margin-top: 40rpx;
  display: inline-block;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  color: #1f1f1f;
  background-color: #ffd100;
  border-radius: 40rpx;
}

.order-status-bar{
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding:38rpx 40rpx 40rpx 40rpx ;
}
.order-status-bar .order-status .title{
  font-size: 30rpx;
  color: #3c3c3c;
}
.order-status-bar .order-status .order-number{
  
  font-size: 24rpx;
  color: #8a8a8a;
  margin-top:10rpx ;
}
.order-status-bar .order-status .order-time{
  
  font-size: 24rpx;
  color: #8a8a8a;
  margin-top: 10rpx;
}
/* 2026-10-12：待支付订单自动取消倒计时（15 分钟未支付自动取消） */
.order-status-bar .order-status .auto-cancel-tip{
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #e64340;
}
/* 2026-10-10：取餐码（自提订单叫号用，= 订单号后 4 位） */
.order-status-bar .order-status .pickup-code{
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #3c3c3c;
}
.order-status-bar .order-status .pickup-code-num{
  display: inline-block;
  padding: 2rpx 16rpx;
  border-radius: 6rpx;
  background-color: #ffd100;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #1f1f1f;
}
.order-status-bar .paid{
  height: 56rpx;
  border-radius: 6rpx;
  background-color: #ffd100;
  
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  line-height: 56rpx;
  color: #1f1f1f;
  padding: 0 8rpx;
}
.blank{
  width: 100vw;
  height: 10rpx;
  background-color: #f5f5f5;
}


page{
