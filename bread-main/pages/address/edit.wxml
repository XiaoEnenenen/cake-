<!-- ===== 新增 / 编辑收货地址 =====
     说明：本页只管「顾客自己的收货地址」，与门店地址无关。
     地图选点为可选能力：未声明 chooseLocation 权限时可手动填写，不影响保存。
 -->
<view class="form-card">
  <view class="form-row">
    <view class="form-label">收货人</view>
    <input
      class="form-input"
      placeholder="请填写收货人姓名"
      placeholder-class="form-placeholder"
      value="{{ name }}"
      data-field="name"
      bindinput="onInput"
      maxlength="20"
    />
  </view>

  <view class="form-row">
    <view class="form-label">手机号</view>
    <input
      class="form-input"
      type="number"
      placeholder="请填写收货人手机号"
      placeholder-class="form-placeholder"
      value="{{ phone }}"
      data-field="phone"
      bindinput="onInput"
      maxlength="11"
    />
  </view>

  <!-- 省市区：使用 Vant 的 van-area（自带行政区划数据，无需第三方地图服务） -->
  <view class="form-row" bindtap="openArea">
    <view class="form-label">所在地区</view>
    <view class="form-picker {{ areaText ? '' : 'form-placeholder' }}">
      {{ areaText || '请选择省 / 市 / 区' }}
    </view>
    <view class="form-arrow"></view>
  </view>

  <!-- 地图选点：微信原生 wx.chooseLocation，无需第三方地图插件与 key -->
  <view class="form-row" bindtap="onChooseLocation">
    <view class="form-label">地图选点</view>
    <view class="form-picker {{ latitude ? '' : 'form-placeholder' }}">
      {{ latitude ? '已选点，可点击重新选择' : '可选：打开地图精确选点' }}
    </view>
    <view class="form-arrow"></view>
  </view>

  <view class="form-row">
    <view class="form-label">详细地址</view>
    <input
      class="form-input"
      placeholder="街道、小区、门牌号等"
      placeholder-class="form-placeholder"
      value="{{ detail }}"
      data-field="detail"
      bindinput="onInput"
      maxlength="60"
    />
  </view>
</view>

<!-- 2026-10-12 阶段 5.7：提示文案与 onSave 的实际校验对齐。
     原文案写「省市区与详细地址至少填其一即可下单」，但 onSave 里**详细地址是必填**
     （edit.js 的 `if (!detail)` 会拦下），照着提示做会被打回，属于自相矛盾的引导。
     现在如实写成：姓名 / 手机号 / 详细地址必填，省市区选填。 -->
<view class="edit-note">
  提示：收货人、手机号、详细地址为必填；省市区选填（配送范围按「省市区 + 详细地址」的文字判断，填了更准，未选点则不走精确距离）。
</view>

<!-- 省市区选择弹层
     说明：不传 area-list，van-area 会使用内置的行政区划数据（无需第三方地图服务与 key） -->
<van-area
  show="{{ showArea }}"
  title="选择所在地区"
  bind:confirm="onAreaConfirm"
  bind:cancel="closeArea"
  bind:close="closeArea"
/>

<!-- 2026-10-09 删除：「标签（家 / 公司 / 学校 / 其他）」整块。
     删除原因：该卡片位于表单最底部，被固定定位的「保存」按钮压住且无法滚动到；
     店主确认不需要地址标签，故整体移除（含 edit.js 的 tags/tag/onTagTap 与相关样式）。 -->

<view class="default-row">
  <view>设为默认地址</view>
  <switch checked="{{ isDefault }}" color="#ffd100" bindchange="onDefaultChange" />
</view>

<!-- 底部占位：避免「设为默认地址」被固定定位的保存按钮遮挡 -->
<view class="edit-bottom-holder"></view>

<view class="addr-bottom">
  <view class="addr-btn {{ saving ? 'disabled' : '' }}" bindtap="onSave">
    {{ saving ? '保存中…' : '保存' }}
  </view>
</view>
