/* 店主端 · 优惠券列表（阶段 11） */
.cp-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.cp-guard {
  margin-top: 200rpx;
  text-align: center;
}
.cp-guard-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f1f1f;
}
.cp-guard-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a8a8a;
}

.cp-head {
  padding: 28rpx 24rpx 18rpx;
}
.cp-head-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f1f1f;
}
.cp-head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8a;
}

.cp-hint {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8a8a8a;
}
.cp-error {
  margin: 40rpx 24rpx;
  padding: 60rpx 0;
  text-align: center;
  background-color: #ffffff;
  border-radius: 16rpx;
}
.cp-error-text {
  font-size: 28rpx;
  color: #8a8a8a;
}
.cp-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 40rpx;
  font-size: 28rpx;
  background-color: #ffd100;
  border-radius: 100rpx;
  color: #1f1f1f;
}

.cp-stats {
  padding: 0 24rpx 16rpx;
  font-size: 24rpx;
  color: #8a8a8a;
}

.cp-empty {
  margin: 0 24rpx;
  padding: 60rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a8a8a;
  background-color: #ffffff;
  border-radius: 16rpx;
}
.cp-empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #b3b3b3;
  line-height: 36rpx;
}

.cp-item {
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  padding: 22rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}
.cp-item-off {
  opacity: 0.55;
}

.cp-item-left {
  width: 150rpx;
  flex-shrink: 0;
  text-align: center;
  padding-right: 16rpx;
  border-right: 1rpx dashed #ebebeb;
}
.cp-amount {
  font-size: 40rpx;
  font-weight: 600;
  color: #ff4b33;
}
.cp-yen {
  font-size: 24rpx;
}
.cp-rule {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}

.cp-item-body {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}
.cp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f1f1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cp-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}
.cp-status {
  font-weight: 600;
}
.cp-status-active {
  color: #2e9e4f;
}
.cp-status-pending {
  color: #d46b08;
}
.cp-status-expired,
.cp-status-soldout {
  color: #b3b3b3;
}
.cp-status-disabled {
  color: #c0392b;
}

.cp-toggle {
  flex-shrink: 0;
  padding: 14rpx 26rpx;
  font-size: 26rpx;
  border-radius: 100rpx;
}
.cp-toggle-off {
  color: #3c3c3c;
  border: 1rpx solid #d9d9d9;
}
.cp-toggle-on {
  color: #1f1f1f;
  font-weight: 600;
  background-color: #ffd100;
}

.cp-bottom-holder {
  height: calc(140rpx + env(safe-area-inset-bottom));
}
.cp-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* z-index：真机上 input 等原生组件会盖在 fixed 元素上方，底部栏必须抬高层级 */
  z-index: 10;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f1f1f;
  background-color: #ffd100;
  padding-bottom: env(safe-area-inset-bottom);
}
