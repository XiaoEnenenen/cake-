<!-- ===== 订单详情页（正在加载 / 加载失败 / 正常）=====
     2026-10-12 阶段 5.6（缺陷 P-07）：整页包一层状态判断。
       原实现无论加载成功与否都渲染下面的区块，接口失败时只剩一堆空标题行，
       顾客看到的是"白屏"，既不知道出了什么事也没有重试入口。
     2026-10-12 复核整改：再加一层「加载中」——
       只判断"失败/非失败"的话，慢网下首帧仍会渲染一屏空标题行。
-->
<view wx:if="{{ loadError }}" class="order-error">
  <view class="order-error-title">订单详情加载失败</view>
  <view class="order-error-tip">请检查网络后重试；若一直失败，可回到订单列表下拉重进</view>
  <view class="order-error-retry" bindtap="retryLoad">点击重试</view>
</view>

<view wx:elif="{{ !loaded }}" class="order-error">
  <view class="order-error-title">订单加载中…</view>
</view>

<block wx:else>
<view class="order-status-bar">
  <view class="order-status">
    <view class="title">订单状态</view>
    <view class="order-number">订单编号：{{ orderDetail.orderInfo.orderNumber }}</view>
    <view class="order-time">下单时间：{{ orderDetail.orderInfo.dateAddText }}</view>
    <!-- 2026-10-12：待支付订单的自动取消倒计时（15 分钟未支付自动取消）。
         剩余时间由服务端下发的 autoCancelAt 现算，前端不硬编码分钟数。 -->
    <view wx:if="{{ orderDetail.orderInfo.status == ST.UNPAID && cancelRemainText }}" class="auto-cancel-tip">
      剩余 {{ cancelRemainText }} 自动取消，请尽快付款
    </view>
    <!-- 2026-10-10：扫码核销下线，自提订单改为展示「取餐码」（订单号后 4 位）。
         外送订单不需要取餐码。 -->
    <view wx:if="{{ orderDetail.orderInfo.deliveryMode != 'delivery' }}" class="pickup-code">
      取餐码：<text class="pickup-code-num">{{ orderDetail.orderInfo.pickupCode }}</text>
    </view>
  </view>
  <view class="paid">{{ orderDetail.orderInfo.statusStr }}</view>
</view>

<view class="blank"></view>

<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">{{ orderDetail.orderInfo.shopNameZt }}</view>
      <!-- <van-icon name="arrow"/> -->
    </view>
    <view class="text">请确认门店正确</view>
  </view>
  <!-- 改造：原写死「自取」，现按订单的「配送方式」显示；
       历史订单无该字段时回退为「自提」。 -->
  <view class="get">{{ orderDetail.extJson['配送方式'] || '自提' }}</view>
</view>

<!-- ===== 改造：显示本店位置（固定坐标 + 标记点）=====
     2026-10-09：改用 components/shop-map 组件，与结算页 / 我的 共用同一份实现。
       地图 + 门店标记（含店名气泡）+ 用户定位蓝点 + 距离气泡 + 一键导航到店。
       坐标来自 shop-config.js；定位授权失败只影响距离显示，不影响导航。
     2026-10-10：外送订单的气泡改为订单快照里的「配送距离」（收货地址 → 门店，
       见 orderDetail.orderInfo.mapDistanceText），自提订单仍是「距离您 X」。
-->
<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">店铺位置</view>
    </view>
  </view>
</view>
<view class="shopmap-block">
  <shop-map
    shop="{{ shop }}"
    height="400rpx"
    show-address="{{ true }}"
    show-navigate="{{ true }}"
    distance-text="{{ orderDetail.orderInfo.mapDistanceText }}"
  />
</view>
<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">联络电话</view>
    </view>
    <view class="text">{{ orderDetail.extJson['联络电话'] }}</view>
  </view>
</view>
<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">{{ orderDetail.extJson['配送方式'] == '外送' ? '配送时间' : '自取时间' }}</view>
    </view>
    <view class="text">{{ orderDetail.extJson['自取时间'] }}</view>
  </view>
</view>
<!-- ===== 改造：外送订单显示收货地址与运费 =====
     地址来源：下单时写入的 extJson 快照（订单一旦生成不再变化，符合快照语义）
-->
<block wx:if="{{ orderDetail.extJson['配送方式'] == '外送' }}">
  <view class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">收货人</view>
      </view>
      <view class="text">{{ orderDetail.extJson['收货人'] }} {{ orderDetail.extJson['收货电话'] }}</view>
    </view>
  </view>
  <view class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">收货地址</view>
      </view>
      <view class="text addr-text">{{ orderDetail.extJson['收货地址'] }}</view>
    </view>
  </view>
  <view wx:if="{{ orderDetail.extJson['配送距离'] }}" class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">配送距离</view>
      </view>
      <view class="text">{{ orderDetail.extJson['配送距离'] }}</view>
    </view>
  </view>
  <view wx:if="{{ orderDetail.extJson['运费'] }}" class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">配送费</view>
      </view>
      <view class="text">{{ orderDetail.extJson['运费'] }}</view>
    </view>
  </view>
</block>

<!-- 保留原配送说明（若商家填写了补充说明） -->
<view wx:if="{{ orderDetail.extJson['配送说明'] }}" class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">配送说明</view>
    </view>
    <view class="text">{{ orderDetail.extJson['配送说明'] }}</view>
  </view>
</view>
<view class="blank1"></view>
<view wx:for="{{orderDetail.goods}}" wx:key="id" class="orderdetails-bar">
  <image mode='aspectFill' class='photos' src='{{ item.pic }}'></image>
  <view class="titles-bar">
    <view class="titles-box1">
      <view class="titles">{{ item.goodsName }}</view>
      <view class="price">
      <text>¥</text>{{ item.amount }}
      </view>
    </view>
    <view class="titles-box2">
      <view class="titles">{{ item.property }}</view>
      <view class="num">×{{ item.number }}</view>
    </view>
  </view>
</view>

<view class="blank2"></view>

<view class="shops-bar1">
  <view class="shops-box">
    <view class="content">
      <view class="titles">备注信息</view>
    </view>
    <view class="text">{{orderDetail.orderInfo.remark}}</view>
  </view>
</view>
<!-- 费用明细（2026-10-14 审查修复）：
     原来只有"共 N 件商品，小计 ¥amountReal"，而 amountReal 是**含打包费 + 运费的实付总额**，
     运费那行取的还是 extJson 里客户端下单时写的快照 → 行项与总额对不上、顾客看不明白。
     现在改为显式的四行：商品金额 / 打包费（>0 才显示）/ 配送费（外送才有）/ 实付合计。 -->
<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">商品金额（共 {{orderDetail.orderInfo.goodsNumber}} 件）</view>
    </view>
    <view class="text">¥{{ orderDetail.orderInfo.goodsAmount }}</view>
  </view>
</view>
<view class="blank1"></view>

<!-- 阶段 9：打包费（订单快照里的 packingFee；本店未收时为 0 → 整块不渲染） -->
<block wx:if="{{ orderDetail.orderInfo.packingFee > 0 }}">
  <view class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">打包费</view>
      </view>
      <view class="text">¥{{ orderDetail.orderInfo.packingFee }}</view>
    </view>
  </view>
  <view class="blank1"></view>
</block>

<!-- 阶段 11：优惠券抵扣（订单快照；0 = 本单没用券 → 整块不渲染）
     「取消订单不退券」是本期明确的取舍，写在这一行下面，别让顾客以为会退。 -->
<block wx:if="{{ orderDetail.orderInfo.couponAmount > 0 }}">
  <view class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">优惠券{{ orderDetail.orderInfo.couponName ? '（' + orderDetail.orderInfo.couponName + '）' : '' }}</view>
      </view>
      <view class="text coupon-amount-text">-¥{{ orderDetail.orderInfo.couponAmount }}</view>
    </view>
  </view>
  <view class="coupon-refund-tip">优惠券使用后，取消订单不退回</view>
  <view class="blank1"></view>
</block>

<!-- 配送费（仅外送；金额取服务端 freight，不再用 extJson 快照）
     freight === null 的老订单没有该字段 → 回退显示 extJson 的文案 -->
<block wx:if="{{ orderDetail.orderInfo.deliveryMode == 'delivery' }}">
  <view class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">配送费</view>
      </view>
      <view class="text">
        {{ orderDetail.orderInfo.freight === 0 ? '免配送费' : (orderDetail.orderInfo.freight ? '¥' + orderDetail.orderInfo.freight : (orderDetail.extJson['运费'] || '待确认')) }}
      </view>
    </view>
  </view>
  <view class="blank1"></view>
</block>

<view class="num-bar">
  <view class="num">共 {{orderDetail.orderInfo.goodsNumber}} 件商品，实付</view>
  <view class="price">
    <text>¥</text>{{orderDetail.orderInfo.amountReal}}
  </view>
</view>
<view class="blank1"></view>

<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">支付方式</view>
    </view>
    <view class="text">微信支付</view>
  </view>
</view>
<view class="blank1"></view>

<!-- 2026-10-10：核销二维码区块已删除（扫码核销不需要了），
     自提订单改在顶部展示「取餐码」。 -->

