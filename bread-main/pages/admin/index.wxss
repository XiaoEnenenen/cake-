/* 店主中心（阶段 10） */
.admin-page {
  min-height: 100vh;
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 非店主：只显示一屏说明，不请求任何店主数据 */
.admin-guard {
  margin-top: 200rpx;
  text-align: center;
}
.admin-guard-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f1f1f;
}
.admin-guard-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a8a8a;
}

.admin-head {
  padding: 10rpx 8rpx 24rpx;
}
.admin-head-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f1f1f;
}
.admin-head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8a;
}

.admin-loading {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8a8a8a;
}
.admin-error {
  padding: 60rpx 0;
  text-align: center;
  background-color: #ffffff;
  border-radius: 16rpx;
}
.admin-error-text {
  font-size: 28rpx;
  color: #8a8a8a;
}
.admin-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 40rpx;
  font-size: 28rpx;
  background-color: #ffd100;
  border-radius: 100rpx;
  color: #1f1f1f;
}

.admin-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx 10rpx 10rpx;
}
.admin-card-title {
  padding: 0 20rpx 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f1f1f;
}
.stat-row {
  display: flex;
  padding-bottom: 24rpx;
}
.stat-row-goods {
  border-top: 1rpx solid #ebebeb;
  padding-top: 24rpx;
}
.stat-cell {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #1f1f1f;
}
.stat-num-warn {
  color: #ff4b33;
}
.stat-num-off {
  color: #b3b3b3;
}
.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8a;
}

.entry-list {
  margin-top: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}
.entry-item {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.entry-item:last-child {
  border-bottom: none;
}
.entry-item-pending .entry-title {
  color: #8a8a8a;
}
.entry-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f1f1f;
  margin-right: 22rpx;
}
.entry-icon-order {
  background-color: #ffd100;
}
.entry-icon-goods {
  background-color: #fff7d6;
}
.entry-icon-delivery {
  background-color: #e8f4ff;
}
.entry-icon-coupon {
  background-color: #f2f2f2;
  color: #8a8a8a;
}
.entry-body {
  flex: 1;
  min-width: 0;
}
.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f1f1f;
}
.entry-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8a8a;
}
.entry-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #c8c8c8;
  border-right: 3rpx solid #c8c8c8;
  transform: rotate(45deg);
  margin-left: 12rpx;
}

.admin-tip {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background-color: #fff7d6;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8a6d00;
}

.admin-devid {
  margin-top: 24rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}
.admin-devid-title {
  font-size: 26rpx;
  color: #8a8a8a;
}
.admin-devid-value {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #1f1f1f;
  word-break: break-all;
}
.admin-devid-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b3b3b3;
}
