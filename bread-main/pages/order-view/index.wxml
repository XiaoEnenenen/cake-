<view class="order-status-bar">
  <view class="order-status">
    <view class="title">订单状态</view>
    <view class="order-number">订单编号：{{ orderDetail.orderInfo.orderNumber }}</view>
    <view class="order-time">下单时间：{{ orderDetail.orderInfo.dateAdd }}</view>
  </view>
  <view class="paid">{{ orderDetail.orderInfo.statusStr }}</view>
</view>

<view class="blank"></view>

<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">{{ orderDetail.orderInfo.shopNameZt }}</view>
      <!-- <van-icon name="arrow"/> -->
    </view>
    <view class="text">请确认门店正确</view>
  </view>
  <!-- 改造：原写死「自取」，现按订单的「配送方式」显示；
       历史订单无该字段时回退为「自提」。 -->
  <view class="get">{{ orderDetail.extJson['配送方式'] || '自提' }}</view>
</view>

<!-- ===== 改造：显示本店位置（固定坐标 + 标记点）=====
     2026-10-09：改用 components/shop-map 组件，与结算页 / 我的 共用同一份实现。
       地图 + 门店标记（含店名气泡）+ 用户定位蓝点 + 「距离您 X」+ 一键导航到店。
       坐标来自 shop-config.js；定位授权失败只影响距离显示，不影响导航。
-->
<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">店铺位置</view>
    </view>
  </view>
</view>
<view class="shopmap-block">
  <shop-map
    shop="{{ shop }}"
    height="400rpx"
    show-address="{{ true }}"
    show-navigate="{{ true }}"
  />
</view>
<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">联络电话</view>
    </view>
    <view class="text">{{ orderDetail.extJson['联络电话'] }}</view>
  </view>
</view>
<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">{{ orderDetail.extJson['配送方式'] == '外送' ? '配送时间' : '自取时间' }}</view>
    </view>
    <view class="text">{{ orderDetail.extJson['自取时间'] }}</view>
  </view>
</view>
<!-- ===== 改造：外送订单显示收货地址与运费 =====
     地址来源：下单时写入的 extJson 快照（订单一旦生成不再变化，符合快照语义）
-->
<block wx:if="{{ orderDetail.extJson['配送方式'] == '外送' }}">
  <view class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">收货人</view>
      </view>
      <view class="text">{{ orderDetail.extJson['收货人'] }} {{ orderDetail.extJson['收货电话'] }}</view>
    </view>
  </view>
  <view class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">收货地址</view>
      </view>
      <view class="text addr-text">{{ orderDetail.extJson['收货地址'] }}</view>
    </view>
  </view>
  <view wx:if="{{ orderDetail.extJson['配送距离'] }}" class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">配送距离</view>
      </view>
      <view class="text">{{ orderDetail.extJson['配送距离'] }}</view>
    </view>
  </view>
  <view wx:if="{{ orderDetail.extJson['运费'] }}" class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">配送费</view>
      </view>
      <view class="text">{{ orderDetail.extJson['运费'] }}</view>
    </view>
  </view>
</block>

<!-- 保留原配送说明（若商家填写了补充说明） -->
<view wx:if="{{ orderDetail.extJson['配送说明'] }}" class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">配送说明</view>
    </view>
    <view class="text">{{ orderDetail.extJson['配送说明'] }}</view>
  </view>
</view>
<view class="blank1"></view>
<view wx:for="{{orderDetail.goods}}" wx:key="id" class="orderdetails-bar">
  <image mode='aspectFill' class='photos' src='{{ item.pic }}'></image>
  <view class="titles-bar">
    <view class="titles-box1">
      <view class="titles">{{ item.goodsName }}</view>
      <view class="price">
      <text>¥</text>{{ item.amount }}
      </view>
    </view>
    <view class="titles-box2">
      <view class="titles">{{ item.property }}</view>
      <view class="num">×{{ item.number }}</view>
    </view>
  </view>
</view>

<view class="blank2"></view>

<view class="shops-bar1">
  <view class="shops-box">
    <view class="content">
      <view class="titles">备注信息</view>
    </view>
    <view class="text">{{orderDetail.orderInfo.remark}}</view>
  </view>
</view>
<view class="num-bar">
  <view class="num">共 {{orderDetail.orderInfo.goodsNumber}} 件商品，小计</view>
  <view class="price">
    <text>¥</text>{{orderDetail.orderInfo.amountReal}}
  </view>
</view>
<view class="blank1"></view>

<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">支付方式</view>
    </view>
    <view class="text">微信支付</view>
  </view>
</view>
<view class="blank1"></view>

<block wx:if="{{orderDetail.orderInfo.hxNumber && orderDetail.orderInfo.status > 0 && orderDetail.orderInfo.status < 3}}">
  <view class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">核销码</view>
      </view>
      <view class="text"><canvas class="hx-canvas" canvas-id="qrcode" /></view>
    </view>
  </view>
  <view class="blank1"></view>
</block>
