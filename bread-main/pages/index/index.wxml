<!-- 2026-09-26 阶段二：已删除顶部积分条（会员积分体系）。
     删除内容：{{userAmount.score}}p 积分显示 + 「下滑查看会员卡」文案。
     对应样式 .inc-bar / .inc-box / .myinc / .p / .slide 已在 index.wxss 中一并移除。 -->

<swiper class='focus' autoplay bindchange="bannerChange">
  <swiper-item wx:for="{{banners}}" wx:key="id">
    <image mode='aspectFill' class='focus' src='{{item.picUrl}}'></image>
  </swiper-item>
</swiper>
<view class="Borders-box">
  <view wx:for="{{banners}}" wx:key="id" class="Borders{{index == curbanner ? '':'1'}}"></view>
</view>

<!-- ===== 本店信息卡（单店固定配置，不涉及定位/地图/距离）=====
     数据来源：shop-config.js → storage.shopInfo
     ================================================================ -->
<view class="shop-card">
  <view class="shop-card-head">
    <view class="shop-card-name">{{ shop.name || '卿欢蛋糕' }}</view>
    <view class="shop-card-badge">自提</view>
  </view>
  <view class="shop-card-hours">营业时间 {{ shop.openingHours || '08:00-20:00' }}</view>
  <view wx:if="{{ shop.address }}" class="shop-card-addr">{{ shop.address }}</view>
  <navigator url="/pages/orders/index" hover-class="none">
    <view class="shop-card-btn">开始点单</view>
  </navigator>
</view>

<view class="section-title">本店上新</view>

