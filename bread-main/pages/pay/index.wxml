<van-notice-bar
  wx:if="{{purchaseNotes}}"
  custom-class="notice-bar"
  background-color="#f5f5f5"
  text="{{purchaseNotes}}"
/>
<!-- ===== 改造：新增「自提 / 外送」配送方式切换 =====
     简化版外送：切换只记录选择，不涉及地址簿、距离校验与运费。
     外送模式下由商家按下方联络电话与顾客确认配送地址。
-->
<view class="mode-bar">
  <view class="mode-tab {{ !isDelivery ? 'active' : '' }}" data-mode="pickup" bindtap="onModeChange">自提</view>
  <view wx:if="{{ deliveryEnabled }}" class="mode-tab {{ isDelivery ? 'active' : '' }}" data-mode="delivery" bindtap="onModeChange">外送</view>
</view>

<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">{{ shopInfo.name }}</view>
    </view>
    <!-- 改造：文案随配送方式变化。原为「距你 X 米，请确认门店正确」（依赖定位距离，已移除），
         且在纯自提时代写死「自提」；现按模式区分。 -->
    <view wx:if="{{ isDelivery }}" class="text">{{ deliveryReminder }}</view>
    <view wx:else class="text">请确认商品与自取时间无误</view>
  </view>
  <view class="get">{{ modeText }}</view>
</view>

<!-- ===== 改造：外送模式下的收货地址选择 ===== -->
<block wx:if="{{ isDelivery }}">
  <view class="shops-bar" bindtap="goSelectAddress">
    <view class="shops-box">
      <view class="content">
        <view class="titles">收货地址</view>
      </view>
      <view wx:if="{{ selectedAddress }}" class="text addr-text">
        {{ selectedAddress.name }} {{ selectedAddress.phone }}
      </view>
      <view wx:else class="text addr-empty">请选择收货地址</view>
    </view>
    <van-icon name="arrow"/>
  </view>

  <!-- 已选地址的详细行 -->
  <view wx:if="{{ selectedAddress }}" class="addr-detail-row">
    <view class="addr-detail-text">{{ addressText }}</view>
  </view>

  <!-- 超出配送范围提示 -->
  <view wx:if="{{ quote && !quote.deliverable }}" class="delivery-warn">
    {{ quote.freightText }}
  </view>
  <!-- 距离/运费说明 -->
  <view wx:elif="{{ deliveryTip }}" class="delivery-tip">{{ deliveryTip }}</view>
</block>

<view class="shops-bar">
  <view class="shops-box">
    <view class="content">
      <view class="titles">联络电话</view>
    </view>
    <view class="text">{{mobile}}</view>
  </view>
  <view class="get1-box" bind:tap="bindMobile">
    <view class="get1">自动填写</view>
  </view>
</view>
<navigator url="/pages/select-time/index" hover-class="none">
  <view class="shops-bar">
    <view class="shops-box">
      <view class="content">
        <view class="titles">{{ isDelivery ? '期望送达时间' : '自取时间' }}</view>
      </view>
      <view class="text">{{fetchTime}}</view>
    </view>
    <van-icon name="arrow"/>
  </view>
</navigator>
<view class="blank1"></view>
<view wx:for="{{shippingCarInfo.items}}" wx:key="key" class="orderdetails-bar">
  <image mode='aspectFill' class='photos' src='{{item.pic}}'></image>
  <view class="titles-bar">
    <view class="titles-box1">
      <view class="titles">{{item.name}}</view>
      <view class="price">
      <text>¥</text>{{item.price}}
      </view>
    </view>
    <view class="titles-box2">
      <view class="titles"> </view>
      <view class="num">×{{ item.number }}</view>
    </view>
  </view>
</view>

<view class="blank2"></view>

<navigator url="/pages/add-note/index" hover-class="none">
  <view class="shops-bar1">
    <view class="shops-box">
      <view class="content">
        <view class="titles">备注信息</view>
      </view>
      <view class="text">{{remark}}</view>
    </view>
    <van-icon name="arrow"/>
  </view>
</navigator>
<view class="num-bar">
  <view class="num">共 {{shippingCarInfo.number}} 件商品，小计</view>
  <view class="price">
    <text>¥</text>{{shippingCarInfo.price}}
  </view>
</view>

<!-- ===== 改造：配送费独立一行（外送时才显示）===== -->
<view wx:if="{{ isDelivery }}" class="num-bar num-bar-freight">
  <view class="num">配送费</view>
  <view class="price {{ freight === 0 ? 'price-free' : '' }}">
    {{ freight === null ? freightText : (freight === 0 ? '免配送费' : '¥' + freight) }}
  </view>
</view>

<view class="blank1"></view>

<view class="blank1 blank-bottom"></view>
<view class="pay-bar">
  <view class="pay-box">
    <view class="title">应付总额</view>
    <view class="price">
      <text>¥</text>{{ isDelivery ? payableAmount : shippingCarInfo.price }}
    </view>
  </view>
  <view class="pay-byn" bindtap="createorder">结算</view>
</view>

<bind-mobile
  title="绑定手机号码"
  alarmText="为保障您的资金安全，请先绑定手机号码"
  show="{{ bindMobileShow }}"
  bind:cancel="bindMobileCancel"
  bind:ok="bindMobileOk"
/>