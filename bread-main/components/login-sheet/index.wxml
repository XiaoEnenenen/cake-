<!-- ===== 登录弹层（2026-10-17）=====
     顾客反馈：退出登录后点「登录」必须重新弹隐私勾选 + 微信登录。
     2026-10-17 顾客确认：不做手机号登录，只保留微信登录；
     手机号是订单联系方式，由顾客在结算页手填 / 「编辑资料」保存，和登录无关。
     注意：没勾选隐私政策时不渲染真正的登录按钮，点击只提示（先同意后登录）。 -->
<view wx:if="{{ show }}" class="ls-mask" catchtouchmove="noop">
  <view class="ls-panel" catchtap="noop">
    <view class="ls-close" bindtap="close">×</view>

    <view class="ls-title">登录 / 注册</view>
    <view class="ls-sub">登录后可查看订单、保存收货地址</view>
    <view class="ls-info">
      <view class="ls-info-line">微信登录：用当前微信身份登录，微信不会弹授权框，也不读取昵称头像。</view>
      <view class="ls-info-line">手机号无需登录：下单时在结算页填写，或到「编辑资料」里保存。</view>
      <view class="ls-info-note">同一个微信就是同一个账号，换手机登录也能看到历史订单。</view>
    </view>

    <view class="ls-check-row" bindtap="toggleCheck">
      <view class="ls-checkbox {{ checked ? 'ls-checkbox-on' : '' }}">{{ checked ? '✓' : '' }}</view>
      <view class="ls-check-text">
        我已阅读并同意
        <text class="ls-link" catchtap="onOpenPolicy">《隐私政策》</text>
        <text class="ls-sep">和</text>
        <text class="ls-link" catchtap="onOpenContract">《微信隐私保护指引》</text>
      </view>
    </view>

    <block wx:if="{{ checked }}">
      <button
        class="ls-btn ls-btn-login {{ logging ? 'ls-btn-disabled' : '' }}"
        disabled="{{ logging }}"
        bindtap="onWechatLogin"
      >{{ logging ? '登录中…' : '微信登录' }}</button>
    </block>

    <!-- 没勾选：只渲染普通按钮样式，点击仅提示，不会发起登录 -->
    <view wx:else class="ls-btn ls-btn-login ls-btn-disabled" bindtap="onLoginBlocked">微信登录</view>

    <view class="ls-cancel" bindtap="close">暂不登录</view>
  </view>
</view>
