/* ===== 卿欢蛋糕 订单结算页样式 =====
   2026-10-09 改版（按店主参考图重做布局与视觉）：
     新增 .seg / .seg-item（分段式配送方式切换）、
          .card（统一白卡片）、.store-card / .store-map-wrap（门店卡，地图本体与距离气泡、
          圆形导航按钮已收敛到 components/shop-map 组件）、
          .goods-item 系列（商品卡）、.row 系列（联络电话 / 时间 / 备注）、
          .fee-row 系列（费用）、.pay-bar 新底部栏。
     删除：旧的 .mode-bar / .mode-tab 下划线 Tab、.shops-bar / .shops-box / .get1-box
          （"自动填写"按钮样式）、.orderdetails-bar / .num-bar 旧列表样式。
   配色令牌见 app.wxss 顶部注释（主黄 #ffd100 / 价格红 #ff4b33 / 促销红 #ff2d2d）。
*/

page {
  position: relative;
  background-color: #f5f5f5;
}

.notice-bar {
  height: 70rpx !important;
  padding: 0 !important;
  background-color: #f5f5f5;
}

.notice-bar .van-notice-bar__content {
  font-size: 28rpx;
  color: #3c3c3c;
}

/* ===== 配送方式：分段控件 ===== */
.seg-wrap {
  padding: 20rpx 30rpx 0;
}

.seg {
  display: flex;
  align-items: center;
  padding: 6rpx;
  background-color: #ededed;
  border-radius: 16rpx;
}

.seg-item {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 30rpx;
  color: #8a8a8a;
  border-radius: 12rpx;
}

.seg-item.active {
  background-color: #ffffff;
  color: #1f1f1f;
  font-weight: 600;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

/* ===== 统一卡片 ===== */
.card {
  margin: 20rpx 30rpx 0;
  padding: 0 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

/* ===== 门店卡片 ===== */
.store-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 26rpx 24rpx;
}

.store-left {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.store-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f1f1f;
  line-height: 46rpx;
}

.store-addr {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8a;
  line-height: 34rpx;
}

.store-hours {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #b3b3b3;
  line-height: 32rpx;
}

/* 门店地图容器：地图本身、门店标记、距离气泡与圆形导航按钮
   都由 components/shop-map 负责（mini 形态），此处只负责在卡片里占位。 */
.store-map-wrap {
  position: relative;
  width: 220rpx;
  height: 150rpx;
  flex-shrink: 0;
  margin-top: 26rpx;
  /* 组件内的圆形导航按钮会向外溢出 16rpx，这里不能裁切 */
  overflow: visible;
}

.store-tip {
  margin: 16rpx 30rpx 0;
  font-size: 24rpx;
  color: #8a8a8a;
  line-height: 34rpx;
}

/* ===== 通用信息行 ===== */
.row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
}

.row-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #1f1f1f;
}

.row-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 28rpx;
  color: #3c3c3c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-empty {
  color: #b3b3b3;
}

.row-input {
  flex: 1;
  height: 100rpx;
  text-align: right;
  font-size: 28rpx;
  color: #1f1f1f;
}

.row-ph {
  color: #b3b3b3;
}

.row-hint {
  padding-bottom: 18rpx;
  text-align: right;
  font-size: 22rpx;
  color: #ff2d2d;
}

/* 分段线画在「后一行」的上边缘，避免卡片最后一行留一条悬空的分割线 */
.row-nav {
  display: block;
  border-top: 1rpx solid #f2f3f5;
}

/* 行尾箭头与右侧文字留一点间距（van-icon 默认紧贴文字） */
.row .van-icon {
  margin-left: 10rpx;
  flex-shrink: 0;
}

/* ===== 收货地址（外送） ===== */
.addr-detail-text {
  padding-bottom: 20rpx;
  font-size: 24rpx;
  color: #8a8a8a;
  line-height: 34rpx;
}

.delivery-warn {
  margin-bottom: 20rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  color: #ff2d2d;
  background-color: #fff7d6;
  border-radius: 10rpx;
}

.delivery-tip {
  margin-bottom: 20rpx;
  font-size: 22rpx;
  color: #8a8a8a;
  line-height: 32rpx;
}

/* ===== 商品列表 ===== */
.goods-item {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-pic {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.goods-name {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  font-size: 28rpx;
  color: #1f1f1f;
  line-height: 40rpx;
}

.goods-right {
  flex-shrink: 0;
  text-align: right;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f1f1f;
  line-height: 40rpx;
}

.goods-num {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}

.goods-empty {
  padding: 46rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #b3b3b3;
}

/* 阶段 5.6 复核整改：购物车加载失败时的重试入口 */
.cart-retry {
  margin-top: 20rpx;
  display: inline-block;
  padding: 10rpx 36rpx;
  font-size: 26rpx;
  color: #1f1f1f;
  background-color: #ffd100;
  border-radius: 40rpx;
}

/* 阶段 5.1 复核整改：无法下单的项（已下架 / 规格被改动）在商品名后标红 */
.goods-unavailable {
  font-size: 24rpx;
  color: #e64340;
}

.yen {
  font-size: 22rpx;
  margin-right: 2rpx;
}

/* ===== 费用 ===== */
.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.fee-row + .fee-row {
  border-top: 1rpx solid #f2f3f5;
}

.fee-label {
  font-size: 26rpx;
  color: #8a8a8a;
}

.fee-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f1f1f;
}

.fee-value .yen {
  font-size: 20rpx;
}

.fee-free {
  font-weight: normal;
  color: #8a8a8a;
}

/* ===== 底部固定栏 ===== */
.bottom-holder {
  height: 200rpx;
}

.pay-bar {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 750rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 30rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}

.pay-box {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.pay-total {
  display: flex;
  align-items: baseline;
}

.pay-label {
  margin-right: 8rpx;
  font-size: 26rpx;
  color: #1f1f1f;
}

.pay-price {
  font-size: 42rpx;
  font-weight: 600;
  color: #ff4b33;
  line-height: 50rpx;
}

.pay-price .yen {
  font-size: 24rpx;
}

.pay-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #b3b3b3;
}

/* 去支付：参考图为深色胶囊按钮 + 白字 */
.pay-byn {
  width: 300rpx;
  height: 84rpx;
  line-height: 84rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background-color: #1f1f1f;
  border-radius: 42rpx;
}

/* 阶段 5.6（缺陷 P-10）：提交中置灰，避免连点重复下单（防抖在 js 里） */
.pay-byn-disabled {
  opacity: 0.6;
}
