.pay-bar{
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  box-shadow: 0 -0.5px 0 0 rgba(0, 0, 0, 0.15);
  background-color: #ffffff;
  display: flex;
  justify-content: space-between;
  position: fixed;
  bottom: 0rpx;
  width: 750rpx;
  height: 120rpx;
}

.pay-bar .pay-box{
  display: flex;
  flex-direction: column;
  margin-left:40rpx ;
  margin-top:20rpx;
}


.pay-bar .pay-box .title{
  
  font-size: 22rpx;

  text-align: justify;
  color: #3c3c3c;
}

.pay-bar .pay-box .price{
  
