page{
  position: relative;
}
.notice-bar{
  height: 70rpx !important;
  padding: 0 !important;
  background-color: #f5f5f5;
}
.notice-bar .van-notice-bar__content {
  
  font-size: 28rpx;
  color: #3c3c3c;
}

/* ===== 改造新增：配送方式切换（自提 / 外送）=====
   简化版外送：仅切换选择，不含地址簿与运费。
   样式对齐点单页的品牌黄选中态。
*/
.mode-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx 0;
  background-color: #ffffff;
}

.mode-tab {
  position: relative;
  font-size: 32rpx;
  color: #8a8a8a;
  padding: 0 24rpx 14rpx;
}

.mode-tab:first-child {
  padding-left: 0;
}

.mode-tab.active {
  font-weight: 600;
  color: #1f1f1f;
}

.mode-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: #ffd100;
}

.mode-tab:first-child.active::after {
  left: 0;
  transform: none;
}
.shops-bar{
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding:20rpx 40rpx ;
}
 .shops-box{
  display: flex;
  flex-direction: column;
}

 .shops-box .content{
  display: flex;
  margin-bottom:10rpx ;

}
 .shops-box .content .titles{
  font-size: 30rpx;
  color: #3c3c3c;
  margin-right: 10rpx;
}
 .shops-box .content .arrrow{
  width: 32rpx;
  height: 32rpx;
  background-color: #4a4a4a;
}
 .shops-box .text{
  
  font-size: 26rpx;
  color: #8a8a8a;
}
/* 自取标签：黑底 → 品牌黄底深字（原黑底 #1f1f1f 与白黄主题冲突） */
 .get{
  width: 92rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background-color: #ffd100;
  
  font-size: 26rpx;
  font-weight: 600;
  color: #1f1f1f;
  text-align: center;
  line-height: 56rpx;
}
.get1-box {
  width: 144rpx;
  height: 56rpx;
  position: relative;
}
.get1{
  width: 100%;
  height: 100%;
  border-radius: 12px;
  border: solid 1px #ff2d2d;
  background-color: #fff7d6;
  
  font-size: 26rpx;
  color: #ff2d2d;
  text-align: center;
  line-height: 56rpx;
}
.get1-box button {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
  opacity: 0;
  z-index: 99;
}

.blank1{
  height: 10rpx;
  background-color: #f5f5f5;
}

