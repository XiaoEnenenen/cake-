/* ===== 改造：收货地址与配送费相关样式 ===== */
.addr-text {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.addr-empty {
  color: #ff2d2d;
}

.addr-detail-row {
  padding: 0 40rpx 16rpx 40rpx;
}

.addr-detail-text {
  font-size: 26rpx;
  color: #8a8a8a;
  line-height: 38rpx;
}

/* 超出配送范围警示 */
.delivery-warn {
  margin: 0 40rpx 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #ff2d2d;
  background-color: #fff7d6;
  border-radius: 10rpx;
}

/* 距离/运费说明 */
.delivery-tip {
  margin: 0 40rpx 16rpx;
  font-size: 24rpx;
  color: #8a8a8a;
  line-height: 36rpx;
}

/* 配送费行 */
.num-bar-freight {
  padding-top: 0;
}

.num-bar-freight .price-free {
  color: #8a8a8a;
  font-size: 26rpx;
  font-weight: normal;
}

.pay-bar{
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  box-shadow: 0 -0.5px 0 0 rgba(0, 0, 0, 0.15);
  background-color: #ffffff;
  display: flex;
  justify-content: space-between;
  position: fixed;
  bottom: 0rpx;
  width: 750rpx;
  height: 120rpx;
}

.pay-bar .pay-box{
  display: flex;
  flex-direction: column;
  margin-left:40rpx ;
  margin-top:20rpx;
}


.pay-bar .pay-box .title{
  
  font-size: 22rpx;

  text-align: justify;
  color: #3c3c3c;
}

.pay-bar .pay-box .price{
  
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4b33;
}

.pay-bar .pay-box .price text{
  width: 14rpx;
  height: 32rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 6rpx;
}

/* 结算按钮：黄底必须配深色字，原白色字在黄底上不可读 */
.pay-bar .pay-byn{
  width: 376rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background-color: #ffd100;
  margin-top: 20rpx;
  margin-right: 40rpx;
  
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  line-height: 80rpx;
  color: #1f1f1f;
}
